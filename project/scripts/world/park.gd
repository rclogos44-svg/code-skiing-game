extends Node3D
## Terrain parks generated by build/parks.py (layout["parks"]): builds the rails, boxes and tubes,
## marks kicker lips and knuckles in orange, puts flags and the park name at the staging area and
## tip boards along the progression line.  The skier slides `rails` (see Skier._try_mount).

const HEIGHT := {"box": 0.35, "rail": 0.55, "tube": 0.5, "widebox": 0.45}
const WIDTH := {"box": 0.5, "rail": 0.07, "tube": 0.7, "widebox": 1.2}   # widebox: a wide "car box"
const ORANGE := Color(1.0, 0.42, 0.05)

var terrain: TerrainData
var rails: Array = []        # {a: Vector3, b: Vector3 (top line), kind, width, length, park}
var parks: Array = []
var _snow: StandardMaterial3D


func setup(td: TerrainData, obstacles: Obstacles) -> void:
	terrain = td
	_snow = _mat(Color(0.9, 0.93, 0.98), 0.85)
	parks = td.layout.get("parks", [])
	for pi in parks.size():
		var pk: Dictionary = parks[pi]
		for r in pk["rails"]:
			if r is Dictionary:
				# shaped rail: points with heights above the park's (un-kickered) snow
				var pts: Array[Vector3] = []
				for q in r["pts"]:
					pts.append(Vector3(q[0], terrain.base_height(q[0], q[1]) + float(q[2]), q[1]))
				_add_feature(String(r["kind"]), pts, obstacles, pi, String(r.get("shape", "straight")))
			else:
				var a2 := Vector2(r[0], r[1])
				var b2 := Vector2(r[2], r[3])
				var h: float = HEIGHT[String(r[4])]
				_add_feature(String(r[4]), [Vector3(a2.x, terrain.height(a2.x, a2.y) + h, a2.y),
					Vector3(b2.x, terrain.height(b2.x, b2.y) + h, b2.y)] as Array[Vector3], obstacles, pi, "straight")
		for k in pk["kickers"]:
			_kicker_mesh(k)
			_mark_kicker(k, pk)
		for pp in pk.get("pipes", []):
			_pipe_mesh(pp)
		for sh in pk.get("shapes", []):
			_shape_mesh(sh)
		_staging(pk)


func park_start(i: int, section := -1) -> Dictionary:
	var pk: Dictionary = parks[clampi(i, 0, parks.size() - 1)]
	var secs: Array = pk.get("sections", [])
	if section > 0 and section < secs.size():
		# a quick drop onto one of the park's routes, facing down the park
		var sc: Dictionary = secs[section]
		return {"pos": Vector3(sc["pos"][0], 0, sc["pos"][1]), "yaw": float(pk["yaw"]), "name": "%s · %s" % [pk["name"], sc["name"]]}
	return {"pos": Vector3(pk["start"][0], 0, pk["start"][1]), "yaw": float(pk["yaw"]), "name": pk["name"]}


## Index of the park containing `pos`, or -1.
func park_at(pos: Vector3) -> int:
	for i in parks.size():
		var pk: Dictionary = parks[i]
		var o := Vector2(pk["origin"][0], pk["origin"][1])
		var d := Vector2(pk["dir"][0], pk["dir"][1])
		var rel := Vector2(pos.x, pos.z) - o
		var s := rel.dot(d)
		if s > -60.0 and s < float(pk["length"]) + 40.0 and absf(rel.dot(Vector2(-d.y, d.x))) < float(pk["half_width"]) + 20.0:
			return i
	return -1


func _add_feature(kind: String, pts: Array[Vector3], obstacles: Obstacles, park_i: int, shape: String) -> void:
	var cum: Array[float] = [0.0]
	for i in range(1, pts.size()):
		cum.append(cum[i - 1] + pts[i].distance_to(pts[i - 1]))
	var length: float = cum[cum.size() - 1]
	rails.append({"a": pts[0], "b": pts[pts.size() - 1], "pts": pts, "cum": cum, "kind": kind, "width": float(WIDTH[kind]),
		"length": length, "park": park_i, "shape": shape})
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var deck := SurfaceTool.new()
	deck.begin(Mesh.PRIMITIVE_TRIANGLES)
	# posts / legs every ~2.5 m along the whole rail
	var n_posts := maxi(int(ceil(length / 2.5)), 1)
	var posts: Array[Vector3] = []
	for k in n_posts + 1:
		posts.append(_rail_point(pts, cum, length * k / n_posts))
	match kind:
		"rail":
			for i in pts.size() - 1:
				_bar(deck, pts[i] - Vector3.UP * 0.035, pts[i + 1] - Vector3.UP * 0.035, 0.035)
			for q0 in posts:
				var q := q0 - Vector3.UP * 0.07
				_bar(st, q, Vector3(q.x, terrain.height(q.x, q.z) - 0.3, q.z), 0.045)
				obstacles.add(q.x, q.z, 0.2, q.y - 1.6, q.y + 0.05, Obstacles.Kind.POLE)
		"tube":
			var r := 0.35
			for i in pts.size() - 1:
				_bar(deck, pts[i] - Vector3.UP * r, pts[i + 1] - Vector3.UP * r, r, 14)
			for q0 in [posts[0], posts[posts.size() - 1]]:
				var q: Vector3 = q0 - Vector3.UP * r
				_bar(st, q, Vector3(q.x, terrain.height(q.x, q.z) - 0.3, q.z), 0.12)
		_:
			var w: float = WIDTH[kind] * 0.5
			for i in pts.size() - 1:
				var dir := pts[i + 1] - pts[i]
				var side := Vector3(dir.x, 0, dir.z).normalized().cross(Vector3.UP)
				var nseg := maxi(int(ceil(dir.length() / 2.5)), 1)
				for k in nseg:
					var q0 := pts[i].lerp(pts[i + 1], float(k) / nseg)
					var q1 := pts[i].lerp(pts[i + 1], float(k + 1) / nseg)
					_quad(deck, q0 - side * w, q0 + side * w, q1 + side * w, q1 - side * w)
					for sg: float in [-1.0, 1.0]:
						var g0 := Vector3(q0.x, terrain.height(q0.x, q0.z) - 0.3, q0.z) + side * (w * sg)
						var g1 := Vector3(q1.x, terrain.height(q1.x, q1.z) - 0.3, q1.z) + side * (w * sg)
						_quad(st, q0 + side * (w * sg), g0, g1, q1 + side * (w * sg))
	st.generate_normals()
	deck.generate_normals()
	var body := MeshInstance3D.new()
	body.mesh = st.commit()
	body.material_override = _mat({"box": ORANGE, "widebox": Color(0.12, 0.35, 0.75), "tube": Color(0.2, 0.2, 0.22), "rail": Color(0.15, 0.15, 0.17)}[kind], 0.5)
	add_child(body)
	var top := MeshInstance3D.new()
	top.mesh = deck.commit()
	top.material_override = _mat({"box": Color(0.92, 0.93, 0.95), "widebox": Color(0.92, 0.93, 0.95), "tube": Color(0.75, 0.77, 0.8), "rail": Color(0.95, 0.85, 0.15)}[kind],
		0.25, 0.6 if not kind.ends_with("box") else 0.0)
	add_child(top)


static func _rail_point(pts: Array[Vector3], cum: Array[float], s: float) -> Vector3:
	for i in pts.size() - 1:
		if s <= cum[i + 1] or i == pts.size() - 2:
			var seg := cum[i + 1] - cum[i]
			return pts[i].lerp(pts[i + 1], clampf((s - cum[i]) / maxf(seg, 0.0001), 0.0, 1.0))
	return pts[0]


## Snow surface of a kicker (TerrainData.kicker_offset gives its shape; the GPU terrain underneath is
## the plain slope), sampled finely on the ramp so the transition reads smooth.
func _kicker_mesh(k: Dictionary) -> void:
	var o := Vector3(k["origin"][0], 0, k["origin"][1])
	var d := Vector3(k["dir"][0], 0, k["dir"][1]).normalized()
	var side := d.cross(Vector3.UP)
	var hw := float(k["half_width"])
	var lr := float(k["ramp"])
	var ld := float(k["deck"])
	var ll := float(k["landing"])
	var ts: Array[float] = []
	for i in 12:
		ts.append(lr * i / 12.0)
	var nd := int(ceil(ld / 1.5))
	for i in nd:
		ts.append(lr + ld * i / nd)
	var nl := int(ceil(ll / 0.8))
	for i in nl + 1:
		ts.append(lr + ld + ll * i / nl)
	var us: Array[float] = []
	for e in [2.0, 1.5, 1.0, 0.5]:
		us.append(-hw - e)
	var ni := int(ceil(hw * 2.0))
	for i in ni + 1:
		us.append(-hw + 2.0 * hw * i / ni)
	for e in [0.5, 1.0, 1.5, 2.0]:
		us.append(hw + e)
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	for t in ts:
		for u in us:
			var q := o + d * t + side * u
			verts.append(Vector3(q.x, terrain.height(q.x, q.z) + 0.03, q.z))
			norms.append(terrain.normal(q.x, q.z, 0.2))
	var idx := PackedInt32Array()
	var nu := us.size()
	for i in ts.size() - 1:
		for j in nu - 1:
			var a := i * nu + j
			idx.append_array([a, a + nu, a + 1, a + 1, a + nu, a + nu + 1])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_NORMAL] = norms
	arr[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.material_override = _snow
	add_child(mi)


## Snow surface of a roller, bank or step-up (TerrainData.shape_offset gives the shape), sampled
## finely along and across so the curves read smooth; the step-up's lip and deck edge are marked.
func _shape_mesh(e: Dictionary) -> void:
	var o := Vector3(e["origin"][0], 0, e["origin"][1])
	var d := Vector3(e["dir"][0], 0, e["dir"][1]).normalized()
	var side := d.cross(Vector3.UP)           # + = the park's right (TerrainData.shape_offset)
	var hw := float(e["half_width"])
	var L := float(e["length"])
	var kind := String(e["kind"])
	var u0 := -hw - 2.0
	var u1 := hw + 2.0
	var du := 0.6
	if kind == "bank":
		var sg := float(e["side"])
		var far := hw + float(e["wall"]) + 4.6
		u0 = minf(sg * (hw - 0.5), sg * far)
		u1 = maxf(sg * (hw - 0.5), sg * far)
		du = 0.4
	var ts: Array[float] = []
	var t := 0.0
	while t < L:
		ts.append(t)
		t += 0.35 if kind == "stepup" else 0.6
	ts.append(L)
	var us: Array[float] = []
	var u := u0
	while u < u1:
		us.append(u)
		u += du
	us.append(u1)
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	for tt in ts:
		for uu in us:
			var q := o + d * tt + side * uu
			verts.append(Vector3(q.x, terrain.height(q.x, q.z) + 0.03, q.z))
			norms.append(terrain.normal(q.x, q.z, 0.2))
	var idx := PackedInt32Array()
	var nu := us.size()
	for i in ts.size() - 1:
		for j in nu - 1:
			var a := i * nu + j
			idx.append_array([a, a + nu, a + 1, a + 1, a + nu, a + nu + 1])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_NORMAL] = norms
	arr[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.material_override = _snow
	add_child(mi)
	if kind == "stepup":
		var st := SurfaceTool.new()
		st.begin(Mesh.PRIMITIVE_TRIANGLES)
		var lr := float(e["ramp"])
		var deck_t := lr + float(e["back"]) + float(e["gap"]) + float(e["face"])
		for tm: float in [lr - 0.3, deck_t + 0.3]:
			var c := o + d * tm
			var pts: Array[Vector3] = []
			for k in 9:
				var q := c + side * lerpf(-hw, hw, k / 8.0)
				q.y = terrain.height(q.x, q.z) + 0.04
				pts.append(q)
			for k in 8:
				var ex := d * 0.18
				_quad(st, pts[k] - ex, pts[k + 1] - ex, pts[k + 1] + ex, pts[k] + ex)
		st.generate_normals()
		var mk := MeshInstance3D.new()
		mk.mesh = st.commit()
		mk.material_override = _mat(ORANGE, 0.6)
		add_child(mk)
		_sign(o + d * (lr - 14.0) + side * (hw + 4.0), "STEP-UP · CARRY SPEED", 34, Color(1, 1, 1))
	elif kind == "bank":
		_sign(o + d * -6.0 + side * (float(e["side"]) * (hw + 3.0)), "BANK " + ("RIGHT" if float(e["side"]) > 0.0 else "LEFT"), 30, Color(1, 1, 1))


## Snow surface of a superpipe (TerrainData.pipe_offset gives its shape over the plain slope): a
## grid fine across the transitions, with a blue line along each coping.
func _pipe_mesh(pp: Dictionary) -> void:
	var o := Vector3(pp["origin"][0], 0, pp["origin"][1])
	var d := Vector3(pp["dir"][0], 0, pp["dir"][1]).normalized()
	var side := d.cross(Vector3.UP)
	var hf := float(pp["flat"]) * 0.5
	var ww := float(pp["wall_w"])
	var outer := hf + ww + float(pp["deck"]) + float(pp["outer"]) + 1.0
	var ts: Array[float] = []
	var t := -2.0
	while t < float(pp["length"]) + 17.0:
		ts.append(t)
		t += 1.5
	var us: Array[float] = []
	var u := hf - 1.0
	while u < outer:
		us.append(u)
		u += 0.35 if u < hf + ww + 0.5 else 1.0
	var all_u: Array[float] = []
	for i in range(us.size() - 1, -1, -1):
		all_u.append(-us[i])
	all_u.append_array(us)
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	for tt in ts:
		for uu in all_u:
			var q := o + d * tt + side * uu
			verts.append(Vector3(q.x, terrain.height(q.x, q.z) + 0.03, q.z))
			norms.append(terrain.normal(q.x, q.z, 0.15))
	var idx := PackedInt32Array()
	var nu := all_u.size()
	for i in ts.size() - 1:
		for j in nu - 1:
			var a := i * nu + j
			idx.append_array([a, a + nu, a + 1, a + 1, a + nu, a + nu + 1])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_NORMAL] = norms
	arr[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.material_override = _snow
	add_child(mi)
	# blue coping lines so the top of each wall reads from below
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for sg: float in [-1.0, 1.0]:
		var prev := Vector3.ZERO
		var tt2 := 0.0
		while tt2 <= float(pp["length"]):
			var q := o + d * tt2 + side * (sg * (hf + ww + 0.1))
			q.y = terrain.height(q.x, q.z) + 0.05
			if tt2 > 0.0:
				_quad(st, prev - side * 0.12, q - side * 0.12, q + side * 0.12, prev + side * 0.12)
			prev = q
			tt2 += 2.0
	st.generate_normals()
	var cl := MeshInstance3D.new()
	cl.mesh = st.commit()
	cl.material_override = _mat(Color(0.1, 0.35, 0.85), 0.6)
	add_child(cl)
	_sign(o - d * 6.0 + side * (hf + ww + 6.0) + Vector3.UP * 2.0, "MEGA PIPE · 22 FT", 60, Color(1, 1, 1))


## Orange lines across the lip and the knuckle so the take-off and landing read from a distance.
func _mark_kicker(k: Dictionary, pk: Dictionary) -> void:
	var d := Vector3(k["dir"][0], 0, k["dir"][1]).normalized()     # a hip points off the fall line
	var side := d.cross(Vector3.UP)
	var hw := float(k["half_width"])
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for key in ["lip", "knuckle"]:
		var c := Vector3(k[key][0], 0, k[key][1]) - d * 0.3
		var p0 := c - side * hw
		var p1 := c + side * hw
		var pts: Array[Vector3] = []
		for t in 9:
			var q := p0.lerp(p1, t / 8.0)
			q.y = terrain.height(q.x, q.z) + 0.03
			pts.append(q)
		for t in 8:
			var e := d * 0.18
			_quad(st, pts[t] - e, pts[t + 1] - e, pts[t + 1] + e, pts[t] + e)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	mi.material_override = _mat(ORANGE, 0.6)
	add_child(mi)
	if k["line"] in ["prog", "jump", "med", "hip", "big", "flow", "bighip"] or k.get("rail_lip", false):
		var tip := c_label(k)
		if tip != "":
			_sign(Vector3(k["lip"][0], 0, k["lip"][1]) - d * 14.0 + side * (hw + 4.0), tip, 34, Color(1, 1, 1))


func c_label(k: Dictionary) -> String:
	if k["line"] != "prog":
		var what := "JUMP"
		if k.get("rail_lip", false):
			return "GAP TO RAIL"
		if absf(float(k.get("yaw", 0.0))) > 1.0:
			what = "HIP " + ("RIGHT" if float(k["yaw"]) > 0.0 else "LEFT")
		elif k.has("knuckle_h"):
			what = "STEP-DOWN"
		if k["size"] == "XS":
			return "SIDE HIT"
		return "%s %s · %d KM/H" % [{"S": "SMALL", "M": "MEDIUM", "L": "LARGE", "XL": "XL"}[k["size"]], what, roundi(float(k["approach_speed"]) * 3.6)]
	return "HOLD ↑ · LET GO AT THE LIP TO POP" if float(k["start_s"]) < 100.0 else "HOLD ↑ · PRESS ↓ AT THE LIP: BACKFLIP"


func _staging(pk: Dictionary) -> void:
	var d := Vector3(pk["dir"][0], 0, pk["dir"][1])
	var side := d.cross(Vector3.UP)
	var s := Vector3(pk["start"][0], 0, pk["start"][1])
	_sign(s + d * 10.0 + Vector3.UP * 2.0, String(pk["name"]).to_upper(), 110, Color(1.0, 0.75, 0.25))
	var lines: Dictionary = pk["lines"]
	var names := {"prog": "PROGRESSION", "jump": "JUMP LINE", "jib": "JIB LINE", "jib_l": "JIB LINE", "med": "MEDIUM JUMPS",
		"hip": "TRANSFERS"}
	if lines.has("med"):
		names["jump"] = "XL LINE"
	names["flow"] = "FLOW LINE"
	names["big"] = "BIG LINE"
	for key in lines:
		_sign(s + d * 28.0 + side * float(lines[key]), names.get(key, String(key).to_upper()), 48, Color(1, 1, 1))
	var fm := _mat(ORANGE, 0.5)
	var pm := _mat(Color(0.2, 0.2, 0.22), 0.5)
	for u: float in [-float(pk["half_width"]), float(pk["half_width"])]:
		for k in 8:
			var p := s + d * (20.0 + k * 70.0) + side * u
			p.y = terrain.height(p.x, p.z)
			var pole := MeshInstance3D.new()
			var cm := CylinderMesh.new()
			cm.top_radius = 0.04
			cm.bottom_radius = 0.04
			cm.height = 2.2
			pole.mesh = cm
			pole.material_override = pm
			pole.position = p + Vector3.UP * 1.1
			add_child(pole)
			var flag := MeshInstance3D.new()
			var bm := BoxMesh.new()
			bm.size = Vector3(0.8, 0.5, 0.02)
			flag.mesh = bm
			flag.material_override = fm
			flag.position = p + Vector3.UP * 1.95 + side * signf(u) * 0.42
			flag.rotation.y = atan2(side.x, side.z) + PI * 0.5
			add_child(flag)


func _sign(p: Vector3, text: String, size: int, col: Color) -> void:
	var l := Label3D.new()
	l.text = text
	l.font = UITheme.font(800)
	l.font_size = size
	l.outline_size = 14
	l.pixel_size = 0.012
	l.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	l.modulate = col
	l.position = Vector3(p.x, terrain.height(p.x, p.z) + 2.5 + p.y, p.z)
	l.visibility_range_end = 260.0
	add_child(l)


func _mat(c: Color, rough: float, metal := 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	m.metallic = metal
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	return m


func _quad(st: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3) -> void:
	for v in [p0, p1, p2, p0, p2, p3]:
		st.add_vertex(v)


func _bar(st: SurfaceTool, a: Vector3, b: Vector3, r: float, segs := 8) -> void:
	var y := (b - a).normalized()
	var x := y.cross(Vector3.FORWARD if absf(y.y) < 0.9 else Vector3.RIGHT).normalized()
	var z := x.cross(y)
	for k in segs:
		var a0 := TAU * k / segs
		var a1 := TAU * (k + 1) / segs
		var o0 := (x * cos(a0) + z * sin(a0)) * r
		var o1 := (x * cos(a1) + z * sin(a1)) * r
		_quad(st, a + o0, b + o0, b + o1, a + o1)
