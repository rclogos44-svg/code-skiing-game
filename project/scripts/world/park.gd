extends Node3D
## Terrain parks generated by build/parks.py (layout["parks"]): builds the rails, boxes and tubes,
## marks kicker lips and knuckles in orange, puts flags and the park name at the staging area and
## tip boards along the progression line.  The skier slides `rails` (see Skier._try_mount).

const HEIGHT := {"box": 0.35, "rail": 0.55, "tube": 0.5}
const WIDTH := {"box": 0.5, "rail": 0.07, "tube": 0.7}
const ORANGE := Color(1.0, 0.42, 0.05)

var terrain: TerrainData
var rails: Array = []        # {a: Vector3, b: Vector3 (top line), kind, width, length, park}
var parks: Array = []
var _snow: StandardMaterial3D


func setup(td: TerrainData, obstacles: Obstacles) -> void:
	terrain = td
	_snow = _mat(Color(0.9, 0.93, 0.98), 0.85)
	parks = td.layout.get("parks", [])
	for pi in parks.size():
		var pk: Dictionary = parks[pi]
		for r in pk["rails"]:
			_add_feature(String(r[4]), Vector2(r[0], r[1]), Vector2(r[2], r[3]), obstacles, pi)
		for k in pk["kickers"]:
			_kicker_mesh(k)
			_mark_kicker(k, pk)
		_staging(pk)


func park_start(i: int) -> Dictionary:
	var pk: Dictionary = parks[clampi(i, 0, parks.size() - 1)]
	return {"pos": Vector3(pk["start"][0], 0, pk["start"][1]), "yaw": float(pk["yaw"]), "name": pk["name"]}


## Index of the park containing `pos`, or -1.
func park_at(pos: Vector3) -> int:
	for i in parks.size():
		var pk: Dictionary = parks[i]
		var o := Vector2(pk["origin"][0], pk["origin"][1])
		var d := Vector2(pk["dir"][0], pk["dir"][1])
		var rel := Vector2(pos.x, pos.z) - o
		var s := rel.dot(d)
		if s > -60.0 and s < float(pk["length"]) + 40.0 and absf(rel.dot(Vector2(-d.y, d.x))) < float(pk["half_width"]) + 20.0:
			return i
	return -1


func _add_feature(kind: String, a2: Vector2, b2: Vector2, obstacles: Obstacles, park_i: int) -> void:
	var h: float = HEIGHT[kind]
	var a := Vector3(a2.x, terrain.height(a2.x, a2.y) + h, a2.y)
	var b := Vector3(b2.x, terrain.height(b2.x, b2.y) + h, b2.y)
	var length := a.distance_to(b)
	var dir := (b - a).normalized()
	rails.append({"a": a, "b": b, "kind": kind, "width": float(WIDTH[kind]), "length": length, "park": park_i})
	var side := Vector3(dir.x, 0, dir.z).normalized().cross(Vector3.UP)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var deck := SurfaceTool.new()
	deck.begin(Mesh.PRIMITIVE_TRIANGLES)
	var n := int(ceil(length / 2.5))
	match kind:
		"rail":
			_bar(deck, a - Vector3.UP * 0.035, b - Vector3.UP * 0.035, 0.035)
			for k in n + 1:
				var q := a.lerp(b, float(k) / n) - Vector3.UP * 0.07
				_bar(st, q, Vector3(q.x, terrain.height(q.x, q.z) - 0.3, q.z), 0.045)
				obstacles.add(q.x, q.z, 0.2, q.y - 1.6, q.y + 0.05, Obstacles.Kind.POLE)
		"tube":
			var r := 0.35
			_bar(deck, a - Vector3.UP * r, b - Vector3.UP * r, r, 14)
			for k in [0, n]:
				var q := a.lerp(b, float(k) / n) - Vector3.UP * r
				_bar(st, q, Vector3(q.x, terrain.height(q.x, q.z) - 0.3, q.z), 0.12)
		_:
			var w: float = WIDTH[kind] * 0.5
			for k in n:
				var q0 := a.lerp(b, float(k) / n)
				var q1 := a.lerp(b, float(k + 1) / n)
				_quad(deck, q0 - side * w, q0 + side * w, q1 + side * w, q1 - side * w)
				for s: float in [-1.0, 1.0]:
					var g0 := Vector3(q0.x, terrain.height(q0.x, q0.z) - 0.3, q0.z) + side * (w * s)
					var g1 := Vector3(q1.x, terrain.height(q1.x, q1.z) - 0.3, q1.z) + side * (w * s)
					_quad(st, q0 + side * (w * s), g0, g1, q1 + side * (w * s))
	st.generate_normals()
	deck.generate_normals()
	var body := MeshInstance3D.new()
	body.mesh = st.commit()
	body.material_override = _mat({"box": ORANGE, "tube": Color(0.2, 0.2, 0.22), "rail": Color(0.15, 0.15, 0.17)}[kind], 0.5)
	add_child(body)
	var top := MeshInstance3D.new()
	top.mesh = deck.commit()
	top.material_override = _mat({"box": Color(0.92, 0.93, 0.95), "tube": Color(0.75, 0.77, 0.8), "rail": Color(0.95, 0.85, 0.15)}[kind],
		0.25, 0.6 if kind != "box" else 0.0)
	add_child(top)


## Snow surface of a kicker (TerrainData.kicker_offset gives its shape; the GPU terrain underneath is
## the plain slope), sampled finely on the ramp so the transition reads smooth.
func _kicker_mesh(k: Dictionary) -> void:
	var o := Vector3(k["origin"][0], 0, k["origin"][1])
	var d := Vector3(k["dir"][0], 0, k["dir"][1]).normalized()
	var side := d.cross(Vector3.UP)
	var hw := float(k["half_width"])
	var lr := float(k["ramp"])
	var ld := float(k["deck"])
	var ll := float(k["landing"])
	var ts: Array[float] = []
	for i in 12:
		ts.append(lr * i / 12.0)
	var nd := int(ceil(ld / 1.5))
	for i in nd:
		ts.append(lr + ld * i / nd)
	var nl := int(ceil(ll / 0.8))
	for i in nl + 1:
		ts.append(lr + ld + ll * i / nl)
	var us: Array[float] = []
	for e in [2.0, 1.5, 1.0, 0.5]:
		us.append(-hw - e)
	var ni := int(ceil(hw * 2.0))
	for i in ni + 1:
		us.append(-hw + 2.0 * hw * i / ni)
	for e in [0.5, 1.0, 1.5, 2.0]:
		us.append(hw + e)
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	for t in ts:
		for u in us:
			var q := o + d * t + side * u
			verts.append(Vector3(q.x, terrain.height(q.x, q.z) + 0.03, q.z))
			norms.append(terrain.normal(q.x, q.z, 0.2))
	var idx := PackedInt32Array()
	var nu := us.size()
	for i in ts.size() - 1:
		for j in nu - 1:
			var a := i * nu + j
			idx.append_array([a, a + nu, a + 1, a + 1, a + nu, a + nu + 1])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_NORMAL] = norms
	arr[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.material_override = _snow
	add_child(mi)


## Orange lines across the lip and the knuckle so the take-off and landing read from a distance.
func _mark_kicker(k: Dictionary, pk: Dictionary) -> void:
	var d := Vector3(pk["dir"][0], 0, pk["dir"][1])
	var side := d.cross(Vector3.UP)
	var hw := float(k["half_width"])
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for key in ["lip", "knuckle"]:
		var c := Vector3(k[key][0], 0, k[key][1]) - d * 0.3
		var p0 := c - side * hw
		var p1 := c + side * hw
		var pts: Array[Vector3] = []
		for t in 9:
			var q := p0.lerp(p1, t / 8.0)
			q.y = terrain.height(q.x, q.z) + 0.03
			pts.append(q)
		for t in 8:
			var e := d * 0.18
			_quad(st, pts[t] - e, pts[t + 1] - e, pts[t + 1] + e, pts[t] + e)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	mi.material_override = _mat(ORANGE, 0.6)
	add_child(mi)
	if k["line"] == "prog" or k["line"] == "jump":
		var tip := c_label(k)
		if tip != "":
			_sign(Vector3(k["lip"][0], 0, k["lip"][1]) - d * 14.0 + side * (hw + 4.0), tip, 34, Color(1, 1, 1))


func c_label(k: Dictionary) -> String:
	if k["line"] != "prog":
		return "%s JUMP · %d KM/H" % [{"S": "SMALL", "M": "MEDIUM", "L": "LARGE"}[k["size"]], roundi(float(k["approach_speed"]) * 3.6)]
	return "HOLD ↑ · LET GO AT THE LIP TO POP" if float(k["start_s"]) < 100.0 else "HOLD ↑ · PRESS ↓ AT THE LIP: BACKFLIP"


func _staging(pk: Dictionary) -> void:
	var d := Vector3(pk["dir"][0], 0, pk["dir"][1])
	var side := d.cross(Vector3.UP)
	var s := Vector3(pk["start"][0], 0, pk["start"][1])
	_sign(s + d * 10.0 + Vector3.UP * 2.0, String(pk["name"]).to_upper(), 110, Color(1.0, 0.75, 0.25))
	var lines: Dictionary = pk["lines"]
	var names := {"prog": "PROGRESSION", "jump": "JUMP LINE", "jib": "JIB LINE"}
	for key in lines:
		_sign(s + d * 28.0 + side * float(lines[key]), names[key], 48, Color(1, 1, 1))
	var fm := _mat(ORANGE, 0.5)
	var pm := _mat(Color(0.2, 0.2, 0.22), 0.5)
	for u: float in [-float(pk["half_width"]), float(pk["half_width"])]:
		for k in 8:
			var p := s + d * (20.0 + k * 70.0) + side * u
			p.y = terrain.height(p.x, p.z)
			var pole := MeshInstance3D.new()
			var cm := CylinderMesh.new()
			cm.top_radius = 0.04
			cm.bottom_radius = 0.04
			cm.height = 2.2
			pole.mesh = cm
			pole.material_override = pm
			pole.position = p + Vector3.UP * 1.1
			add_child(pole)
			var flag := MeshInstance3D.new()
			var bm := BoxMesh.new()
			bm.size = Vector3(0.8, 0.5, 0.02)
			flag.mesh = bm
			flag.material_override = fm
			flag.position = p + Vector3.UP * 1.95 + side * signf(u) * 0.42
			flag.rotation.y = atan2(side.x, side.z) + PI * 0.5
			add_child(flag)


func _sign(p: Vector3, text: String, size: int, col: Color) -> void:
	var l := Label3D.new()
	l.text = text
	l.font = UITheme.font(800)
	l.font_size = size
	l.outline_size = 14
	l.pixel_size = 0.012
	l.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	l.modulate = col
	l.position = Vector3(p.x, terrain.height(p.x, p.z) + 2.5 + p.y, p.z)
	l.visibility_range_end = 260.0
	add_child(l)


func _mat(c: Color, rough: float, metal := 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	m.metallic = metal
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	return m


func _quad(st: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3) -> void:
	for v in [p0, p1, p2, p0, p2, p3]:
		st.add_vertex(v)


func _bar(st: SurfaceTool, a: Vector3, b: Vector3, r: float, segs := 8) -> void:
	var y := (b - a).normalized()
	var x := y.cross(Vector3.FORWARD if absf(y.y) < 0.9 else Vector3.RIGHT).normalized()
	var z := x.cross(y)
	for k in segs:
		var a0 := TAU * k / segs
		var a1 := TAU * (k + 1) / segs
		var o0 := (x * cos(a0) + z * sin(a0)) * r
		var o1 := (x * cos(a1) + z * sin(a1)) * r
		_quad(st, a + o0, b + o0, b + o1, a + o1)
